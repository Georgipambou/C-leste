import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import webpush from "npm:web-push@3.6.7";

const VAPID_PUBLIC_KEY = Deno.env.get("VAPID_PUBLIC_KEY")!;
const VAPID_PRIVATE_KEY = Deno.env.get("VAPID_PRIVATE_KEY")!;
const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
const SUPABASE_SERVICE_KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;

webpush.setVapidDetails(
  "mailto:celeste@gmail.com",
  VAPID_PUBLIC_KEY,
  VAPID_PRIVATE_KEY
);

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_KEY);

Deno.serve(async (req) => {
  try {
    const body = await req.json();
    const record = body.record;
    if (!record) return new Response("Pas de record", { status: 400 });

    const senderId = record.sender_id;
    const convId = record.conv_id;
    const msgText = record.text || "";
    const msgType = record.type || "text";

    const { data: conv } = await supabase
      .from("conversations")
      .select("user1_id, user2_id")
      .eq("id", convId)
      .single();

    if (!conv) return new Response("Conversation introuvable", { status: 200 });

    const recipientId = conv.user1_id === senderId ? conv.user2_id : conv.user1_id;

    const { data: subData } = await supabase
      .from("push_subscriptions")
      .select("subscription")
      .eq("user_id", recipientId)
      .single();

    if (!subData?.subscription) return new Response("Pas de subscription", { status: 200 });

    const { data: sender } = await supabase
      .from("profiles")
      .select("prenom, nom")
      .eq("id", senderId)
      .single();

    const senderName = sender
      ? `${sender.prenom || ""} ${(sender.nom || "")[0] || ""}.`.trim()
      : "Quelqu'un";

    const notifBody =
      msgType === "photo" ? "📷 Photo"
      : msgType === "video" ? "🎥 Vidéo"
      : msgType === "file" ? "📎 Fichier"
      : msgText || "…";

    const payload = JSON.stringify({
      title: `✦ ${senderName}`,
      body: notifBody,
      icon: "/icon-192.png",
      tag: `msg-${convId}`,
      renotify: true,
      data: { convId, url: "/" }
    });

    await webpush.sendNotification(JSON.parse(subData.subscription), payload);

    return new Response("OK", { status: 200 });
  } catch (err) {
    console.error("Erreur:", err);
    return new Response("Erreur interne", { status: 500 });
  }
});
