{
  "appId": "social.celesteapp",
  "appName": "Céleste",
  "webDir": "dist",
  "plugins": {
    "PrivacyScreen": {
      "enable": true,
      "preventScreenshots": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
