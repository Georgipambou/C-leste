{
  "rewrites": [
    { "source": "/a/:slug", "destination": "/api/a?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/ffmpeg-core.js",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/ffmpeg-core.wasm",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}